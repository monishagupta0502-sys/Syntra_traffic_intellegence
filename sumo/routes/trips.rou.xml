<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTRA Simulated Demand & Microscopic Vehicle Trajectories -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="4.8" minGap="2.5" maxSpeed="16.67" guiShape="passenger"/>
    <vType id="transit_bus" accel="1.2" decel="3.5" sigma="0.3" length="12.0" minGap="3.0" maxSpeed="13.89" guiShape="bus"/>
    <vType id="emergency_vehicle" accel="3.5" decel="5.0" sigma="0.1" length="6.0" minGap="2.0" maxSpeed="22.22" guiShape="emergency"/>

    <!-- Main arterial route -->
    <route id="r_main_eb" edges="E_N1_N2 E_N2_N3 E_N3_N4"/>
    <route id="r_main_wb" edges="E_N4_N3 E_N3_N2 E_N2_N1"/>
    
    <!-- Secondary diversion route -->
    <route id="r_diversion_eb" edges="E_N1_N5 E_N5_N6 E_N6_N7 E_N7_N8 E_N8_N4"/>

    <!-- High-frequency vehicle flow (2400 vehicles/hour) -->
    <flow id="flow_arterial_eb" type="car" begin="0" end="3600" number="1800" from="E_N1_N2" to="E_N3_N4"/>
    <flow id="flow_arterial_wb" type="car" begin="0" end="3600" number="1400" from="E_N4_N3" to="E_N2_N1"/>
    <flow id="flow_secondary" type="car" begin="0" end="3600" number="800" from="E_N5_N6" to="E_N7_N8"/>
</routes>
